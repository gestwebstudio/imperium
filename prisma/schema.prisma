// Imperium Motors — контент админки (новости, отзывы).
// Машины НЕ здесь — они приходят из внешней системы учёта (lib/cars.ts).
// SQLite (один файл) для разработки; в прод меняется datasource на Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model News {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  body      String // абзацы через двойной перенос строки
  image     String
  imageAlt  String
  date      DateTime @default(now())
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  author    String
  car       String
  text      String
  image     String
  imageAlt  String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
