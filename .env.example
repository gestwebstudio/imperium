DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_HOURS=8
# Set only to a header that your hosting proxy overwrites and guarantees.
# Without it, login throttling safely falls back to one shared anonymous bucket.
ADMIN_TRUSTED_PROXY_IP_HEADER=
# Comma-separated HTTPS hosts allowed for images entered through the admin UI.
ADMIN_IMAGE_HOSTS=
# Set true in preview/test to observe violations before enforcing CSP.
CSP_REPORT_ONLY=false
